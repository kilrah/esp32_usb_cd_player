# Settings common to all boards. Target/board specific settings are in sdkconfig.defaults.<target>
# (applied automatically): esp32s3 = LilyGO T-Display S3, esp32p4 = Guition JC1060P470.
# The target is chosen by the CMake preset (CMakePresets.json): "idf.py build" = T-Display S3,
# "idf.py --preset p4 build" = JC1060P470.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# 16 MB flash, QIO. Changing the flash mode needs a cable flash: OTA refuses images with another mode
# (ESP_ERR_OTA_SPI_MODE_MISMATCH).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y

# LVGL (display UI)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# Partitions: 2x 2.5 MB OTA app slots + LittleFS "storage" (partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# An OTA image boots as "pending verify" and is rolled back on the next reset unless the app
# confirms it (done once Wi-Fi is up and the OTA server is reachable, see main/net.c)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
# Larger TCP receive window: faster OTA uploads (buffers can go to PSRAM)
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# I2S ISR runs while the flash cache is disabled (OTA, LittleFS writes), so auto-clear keeps
# writing silence on underrun instead of the DMA ring looping its last audio
CONFIG_I2S_ISR_IRAM_SAFE=y

# HTTPS (MusicBrainz / Cover Art Archive lookups): TLS buffers in PSRAM, internal RAM is tight
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# archive.org (Cover Art Archive redirect target) sends a GoDaddy chain cross-signed by the old Class 2
# root, which is not in the bundle; this lets the chain end at the bundled Go Daddy G2 root instead
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# Sockets: the HTTP server takes up to max_open_sockets + 3 (ota.c caps it at 5). With the default of 10,
# a browser holding keep-alive connections left none for the HTTPS lookups ("Failed to create socket").
CONFIG_LWIP_MAX_SOCKETS=16

# uxTaskGetSystemState() for the 'm' serial command (task stacks: location and unused bytes)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# malloc() of 4 KB or more goes to PSRAM (default 16 KB): LVGL objects, CD-TEXT tables, httpd buffers.
# Drivers that need DMA or ISR-safe memory request it with heap_caps_*; internal RAM is tight.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
