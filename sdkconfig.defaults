# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# ESP32-S3 N16R8: 16 MB quad flash, 8 MB octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# QIO flash (T-Display S3: QIO flash + octal PSRAM, as in LilyGO's own "qio_opi" config). Changing the
# flash mode needs a cable flash: OTA refuses images with another mode (ESP_ERR_OTA_SPI_MODE_MISMATCH).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# LilyGO T-Display S3: console on UART0 via external USB-serial adapter
# (TX = GPIO16, RX = GPIO21; the silkscreen on the board is misleading). The native USB port is used as USB Host for the drive.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=16
CONFIG_ESP_CONSOLE_UART_RX_GPIO=21
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# LVGL (display UI)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# Partitions: 2x 2.5 MB OTA app slots + LittleFS "storage" (partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# An OTA image boots as "pending verify" and is rolled back on the next reset unless the app
# confirms it (done once Wi-Fi is up and the OTA server is reachable, see main/net.c)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Wi-Fi. Keep the USB PHY enabled when the Wi-Fi PHY initializes: the drive is on the native USB port
CONFIG_ESP_PHY_ENABLE_USB=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
# Larger TCP receive window: faster OTA uploads (buffers can go to PSRAM)
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# I2S ISR runs while the flash cache is disabled (OTA, LittleFS writes), so auto-clear keeps
# writing silence on underrun instead of the DMA ring looping its last audio
CONFIG_I2S_ISR_IRAM_SAFE=y

# HTTPS (MusicBrainz / Cover Art Archive lookups): TLS buffers in PSRAM, internal RAM is tight
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# archive.org (Cover Art Archive redirect target) sends a GoDaddy chain cross-signed by the old Class 2
# root, which is not in the bundle; this lets the chain end at the bundled Go Daddy G2 root instead
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# Sockets: the HTTP server takes up to max_open_sockets + 3 (ota.c caps it at 5). With the default of 10,
# a browser holding keep-alive connections left none for the HTTPS lookups ("Failed to create socket").
CONFIG_LWIP_MAX_SOCKETS=16

# uxTaskGetSystemState() for the 'm' serial command (task stacks: location and unused bytes)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# malloc() of 4 KB or more goes to PSRAM (default 16 KB): LVGL objects, CD-TEXT tables, httpd buffers.
# Drivers that need DMA or ISR-safe memory request it with heap_caps_*; internal RAM is tight.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Wi-Fi code in flash instead of IRAM: ~15 KB more internal RAM, slightly lower Wi-Fi throughput
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
